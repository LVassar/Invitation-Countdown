<!DOCTYPE index.html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Countdown</title>

  <style>
    :root {
      --countdown-color: #000000;
      --countdown-size: 32px;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100%;
      background: transparent !important;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        sans-serif;
    }

    .countdown {
      width: 100%;
      max-width: 1200px;
      padding: 0.5em;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(8px, 2vw, 28px);
      color: var(--countdown-color);
      font-size: var(--countdown-size);
      line-height: 1;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .unit {
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .number {
      font-size: 1em;
      font-weight: 500;
      line-height: 1;
      white-space: nowrap;
    }

    .label {
      margin-top: 0.35em;
      font-size: 0.3em;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* Prevent oversized numbers on very narrow embeds */
    @media (max-width: 360px) {
      .countdown {
        gap: 4px;
        padding: 0.25em;
      }
    }
  </style>
</head>

<body>

  <div
    class="countdown"
    id="countdown"
    aria-label="Countdown timer"
  >
    <div class="unit">
      <div class="number" id="days">00</div>
      <div class="label">Days</div>
    </div>

    <div class="unit">
      <div class="number" id="hours">00</div>
      <div class="label">Hours</div>
    </div>

    <div class="unit">
      <div class="number" id="minutes">00</div>
      <div class="label">Minutes</div>
    </div>

    <div class="unit">
      <div class="number" id="seconds">00</div>
      <div class="label">Seconds</div>
    </div>
  </div>

  <script>
    (() => {
      "use strict";

      /*
       * ------------------------------------------------------------
       * URL PARAMETERS
       *
       * Example:
       *
       * ?date=2026-12-25
       * &time=18:30
       * &tz=America/Los_Angeles
       * &font=Playfair+Display
       * &color=%23B45F5F
       * &size=42
       *
       * IMPORTANT:
       * URLSearchParams automatically decodes:
       *   %23 -> #
       *   +   -> space
       * ------------------------------------------------------------
       */

      const params = new URLSearchParams(window.location.search);

      // ------------------------------------------------------------
      // FALLBACK DEFAULTS
      // ------------------------------------------------------------

      const DEFAULTS = {
        time: "00:00",
        timezone: "UTC",
        font: "system-ui",
        color: "#000000",
        size: 32
      };

      // ------------------------------------------------------------
      // HELPER FUNCTIONS
      // ------------------------------------------------------------

      function getParameter(name, fallback) {
        const value = params.get(name);

        if (value === null || value.trim() === "") {
          return fallback;
        }

        return value.trim();
      }

      function isValidHexColor(value) {
        return /^#([0-9A-F]{3}|[0-9A-F]{6})$/i.test(value);
      }

      function getValidSize(value) {
        const number = parseFloat(value);

        if (!Number.isFinite(number) || number <= 0) {
          return DEFAULTS.size;
        }

        // Prevent accidental enormous font sizes.
        return Math.min(Math.max(number, 8), 300);
      }

      function pad(number) {
        return String(number).padStart(2, "0");
      }

      // ------------------------------------------------------------
      // READ URL PARAMETERS
      // ------------------------------------------------------------

      const dateParameter = getParameter("date", "");
      const timeParameter = getParameter("time", DEFAULTS.time);
      const timezoneParameter = getParameter(
        "tz",
        DEFAULTS.timezone
      );
      const fontParameter = getParameter(
        "font",
        DEFAULTS.font
      );

      let colorParameter = getParameter(
        "color",
        DEFAULTS.color
      );

      const sizeParameter = getValidSize(
        getParameter("size", DEFAULTS.size)
      );

      // ------------------------------------------------------------
      // COLOR
      // ------------------------------------------------------------

      // If someone enters "000000", turn it into "#000000".
      if (!colorParameter.startsWith("#")) {
        colorParameter = "#" + colorParameter;
      }

      if (!isValidHexColor(colorParameter)) {
        colorParameter = DEFAULTS.color;
      }

      // ------------------------------------------------------------
      // FONT
      // ------------------------------------------------------------

      function loadGoogleFont(fontName) {
        if (
          !fontName ||
          fontName === "system-ui" ||
          fontName === "sans-serif"
        ) {
          return;
        }

        const existingLink = document.querySelector(
          'link[data-countdown-font]'
        );

        if (existingLink) {
          existingLink.remove();
        }

        const link = document.createElement("link");

        link.rel = "stylesheet";
        link.dataset.countdownFont = "true";

        const encodedFont = fontName.trim().replace(/\s+/g, "+");

        link.href =
          "https://fonts.googleapis.com/css2?family=" +
          encodeURIComponent(encodedFont).replace(/%2B/g, "+") +
          "&display=swap";

        document.head.appendChild(link);
      }

      // ------------------------------------------------------------
      // TIMEZONE SUPPORT
      // ------------------------------------------------------------

      /*
       * Converts a date/time in a named IANA timezone into the
       * corresponding UTC timestamp.
       *
       * Examples of valid IANA zones:
       *
       * America/New_York
       * America/Los_Angeles
       * America/Chicago
       * America/Denver
       * Europe/London
       * Europe/Paris
       * Asia/Tokyo
       * Australia/Sydney
       * UTC
       */

      function getTimeZoneOffset(date, timeZone) {
        const formatter = new Intl.DateTimeFormat("en-US", {
          timeZone,
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hourCycle: "h23"
        });

        const parts = formatter.formatToParts(date);
        const values = {};

        for (const part of parts) {
          if (part.type !== "literal") {
            values[part.type] = part.value;
          }
        }

        const asUTC = Date.UTC(
          Number(values.year),
          Number(values.month) - 1,
          Number(values.day),
          Number(values.hour),
          Number(values.minute),
          Number(values.second)
        );

        return asUTC - date.getTime();
      }

      function zonedDateTimeToUTC(dateString, timeString, timeZone) {
        const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(
          dateString
        );

        const timeMatch = /^(\d{2}):(\d{2})$/.exec(
          timeString
        );

        if (!dateMatch || !timeMatch) {
          return null;
        }

        const year = Number(dateMatch[1]);
        const month = Number(dateMatch[2]);
        const day = Number(dateMatch[3]);
        const hour = Number(timeMatch[1]);
        const minute = Number(timeMatch[2]);

        if (
          month < 1 ||
          month > 12 ||
          day < 1 ||
          day > 31 ||
          hour < 0 ||
          hour > 23 ||
          minute < 0 ||
          minute > 59
        ) {
          return null;
        }

        /*
         * Start with the requested wall-clock time treated as UTC.
         * Then calculate the actual offset of the requested timezone
         * and correct for it.
         */
        let utcGuess = Date.UTC(
          year,
          month - 1,
          day,
          hour,
          minute,
          0
        );

        for (let i = 0; i < 3; i++) {
          const offset = getTimeZoneOffset(
            new Date(utcGuess),
            timeZone
          );

          utcGuess =
            Date.UTC(
              year,
              month - 1,
              day,
              hour,
              minute,
              0
            ) - offset;
        }

        return new Date(utcGuess);
      }

      // ------------------------------------------------------------
      // DEFAULT DATE
      // ------------------------------------------------------------

      /*
       * If no date is provided, default to 30 days from now.
       * This ensures the timer never throws an error because
       * the Canva template has not been configured yet.
       */

      function getDefaultDate() {
        const date = new Date();
        date.setDate(date.getDate() + 30);

        return (
          date.getUTCFullYear() +
          "-" +
          pad(date.getUTCMonth() + 1) +
          "-" +
          pad(date.getUTCDate())
        );
      }

      const targetDate =
        dateParameter || getDefaultDate();

      // ------------------------------------------------------------
      // BUILD TARGET DATE
      // ------------------------------------------------------------

      let targetTime;

      try {
        targetTime = zonedDateTimeToUTC(
          targetDate,
          timeParameter,
          timezoneParameter
        );
      } catch (error) {
        targetTime = null;
      }

      /*
       * If the timezone is invalid or the date is invalid,
       * fall back to a safe countdown 30 days from now.
       */

      if (!targetTime || isNaN(targetTime.getTime())) {
        targetTime = new Date(
          Date.now() + 30 * 24 * 60 * 60 * 1000
        );
      }

      // ------------------------------------------------------------
      // APPLY VISUAL SETTINGS
      // ------------------------------------------------------------

      document.documentElement.style.setProperty(
        "--countdown-color",
        colorParameter
      );

      document.documentElement.style.setProperty(
        "--countdown-size",
        sizeParameter + "px"
      );

      if (
        fontParameter !== "system-ui" &&
        fontParameter !== "sans-serif"
      ) {
        loadGoogleFont(fontParameter);

        document.body.style.fontFamily =
          '"' +
          fontParameter.replace(/"/g, "") +
          '", system-ui, sans-serif';
      }

      // ------------------------------------------------------------
      // DOM ELEMENTS
      // ------------------------------------------------------------

      const daysElement =
        document.getElementById("days");

      const hoursElement =
        document.getElementById("hours");

      const minutesElement =
        document.getElementById("minutes");

      const secondsElement =
        document.getElementById("seconds");

      // ------------------------------------------------------------
      // UPDATE COUNTDOWN
      // ------------------------------------------------------------

      function updateCountdown() {
        const now = Date.now();
        const difference =
          targetTime.getTime() - now;

        if (difference <= 0) {
          daysElement.textContent = "00";
          hoursElement.textContent = "00";
          minutesElement.textContent = "00";
          secondsElement.textContent = "00";
          return;
        }

        const totalSeconds =
          Math.floor(difference / 1000);

        const days =
          Math.floor(totalSeconds / 86400);

        const hours =
          Math.floor(
            (totalSeconds % 86400) / 3600
          );

        const minutes =
          Math.floor(
            (totalSeconds % 3600) / 60
          );

        const seconds =
          totalSeconds % 60;

        daysElement.textContent = String(days);
        hoursElement.textContent = pad(hours);
        minutesElement.textContent = pad(minutes);
        secondsElement.textContent = pad(seconds);
      }

      // Initial render
      updateCountdown();

      // Update once per second
      setInterval(updateCountdown, 1000);

    })();
  </script>

</body>
</html>
